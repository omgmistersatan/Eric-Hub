-- Botão para encontrar chest mais próximo
ControlSection:Button({
    Title = "Ir para Chest Mais Próximo",
    Desc = "Vai para o chest mais próximo de você",
    Icon = "target",
    Callback = function()
        local chests = findAllChests()
        if #chests == 0 then
            WindUI:Notify({
                Title = "Nenhum Chest",
                Content = "Nenhum chest encontrado no mapa!",
                Duration = 3,
                Icon = "x-circle",
            })
            return
