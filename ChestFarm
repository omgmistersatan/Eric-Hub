        local nearestChest = sortedChests[1]
        
        if nearestChest then
            WindUI:Notify({
                Title = "Indo para Chest",
                Content = "Viajando para: " .. nearestChest.Name,
                Duration = 2,
                Icon = "navigation",
            })
            goToChest(nearestChest)
            WindUI:Notify({
                Title = "Chegou!",
                Content = "Você chegou no chest!",
                Duration = 2,
                Icon = "check-circle",
            })
        end
    end
})

-- Botão para ir para TODOS os chests (otimizado)
ControlSection:Button({
    Title = "Ir para Todos os Chests",
    Desc = "Visita TODOS os chests do mapa (do mais próximo ao mais longe)",
    Icon = "map",
    Callback = function()
        if isGoingToAll then
            WindUI:Notify({
                Title = "Já em Andamento",
                Content = "Já estou visitando todos os chests!",
                Duration = 2,
                Icon = "alert-circle",
            })
            return
        end
        
        local allChests = findAllChests()
        if #allChests == 0 then
            WindUI:Notify({
                Title = "Nenhum Chest",
                Content = "Nenhum chest encontrado no mapa!",
                Duration = 3,
                Icon = "x-circle",
            })
            return
        end
        
        isGoingToAll = true
        visitedChests = {}
        
        WindUI:Notify({
            Title = "Iniciando Coleta Total",
            Content = "Visitando TODOS os " .. #allChests .. " chests do mapa!",
            Duration = 3,
            Icon = "play-circle",
        })
        
        spawn(function()
            local chestsVisited = 0
            local chestsToVisit = allChests
            
            while isGoingToAll and #chestsToVisit > 0 do
                -- Reordena os chests pela distância atual a cada iteração
                chestsToVisit = sortChestsByDistance(chestsToVisit)
                
                -- Pega o chest mais próximo
                local currentChest = table.remove(chestsToVisit, 1)
                
                if currentChest and currentChest.Parent then
                    local success = goToChest(currentChest)
                    
                    if success then
                        chestsVisited = chestsVisited + 1
                        visitedChests[currentChest] = true
                        
                        -- Notifica a cada 10 chests
                        if chestsVisited % 10 == 0 or chestsVisited == #allChests then
                            WindUI:Notify({
                                Title = "Progresso",
                                Content = chestsVisited .. "/" .. #allChests .. " chests coletados",
                                Duration = 2,
                                Icon = "trending-up",
                            })
                        end
                        
                        -- Espera baseada no modo
                        if not useTween then
                            wait(0.3) -- Espera curta para TP
                        else
                            wait(0.5) -- Espera para tween
                        end
                    end
                end
            end
            
            isGoingToAll = false
            
            WindUI:Notify({
                Title = "Coleta Completa!",
                Content = "Visitou TODOS os " .. chestsVisited .. " chests do mapa!",
                Duration = 5,
                Icon = "check-circle-2",
            })
        end)
    end
})

-- Botão para parar a coleta
ControlSection:Button({
