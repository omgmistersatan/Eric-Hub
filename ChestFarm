-- Botão para todos os chests
ControlSection:Button({
    Title = "Ir para Todos os Chests",
    Desc = "Visita TODOS os chests do mapa com segurança",
    Icon = "map",
    Callback = function()
        if isGoingToAll then
            WindUI:Notify({
                Title = "Já em Andamento",
                Content = "Já estou visitando todos os chests!",
                Duration = 2,
                Icon = "alert-circle",
            })
            return
        end
        
        if not isCharacterValid() then
            WindUI:Notify({
                Title = "Erro",
                Content = "Personagem inválido!",
                Duration = 3,
                Icon = "x-circle",
            })
            return
        end
        
        local allChests = findAllChests()
        if #allChests == 0 then
            WindUI:Notify({
                Title = "Nenhum Chest",
                Content = "Nenhum chest encontrado!",
                Duration = 3,
                Icon = "x-circle",
            })
            return
        end
        
        isGoingToAll = true
        visitedChests = {}
        
        WindUI:Notify({
            Title = "Iniciando Coleta Segura",
            Content = "Coletando " .. #allChests .. " chests com proteção anti-kick!",
            Duration = 3,
            Icon = "play-circle",
        })
        
        spawn(function()
            local chestsVisited = 0
            local chestsFailed = 0
            local chestsToVisit = allChests
            
            while isGoingToAll and #chestsToVisit > 0 do
                if not isCharacterValid() then
                    WindUI:Notify({
                        Title = "Erro",
                        Content = "Personagem morreu! Parando coleta.",
                        Duration = 3,
                        Icon = "skull",
                    })
                    break
                end
                
                -- Reordena pela distância
                chestsToVisit = sortChestsByDistance(chestsToVisit)
                
                -- Remove chests inválidos
                local validChests = {}
                for _, chest in pairs(chestsToVisit) do
                    if chest and chest.Parent then
                        table.insert(validChests, chest)
                    end
                end
                chestsToVisit = validChests
                
                if #chestsToVisit == 0 then break end
                
                -- Pega o mais próximo
                local currentChest = table.remove(chestsToVisit, 1)
                
                if currentChest and currentChest.Parent then
                    local success = goToChest(currentChest)
                    
                    if success then
                        chestsVisited = chestsVisited + 1
                        visitedChests[currentChest] = true
                        
                        -- Notifica a cada 10 chests
                        if chestsVisited % 10 == 0 or chestsVisited == #allChests then
                            WindUI:Notify({
                                Title = "Progresso",
                                Content = chestsVisited .. "/" .. #allChests .. " chests ✓",
                                Duration = 2,
                                Icon = "trending-up",
                            })
                        end
                    else
                        chestsFailed = chestsFailed + 1
                    end
                end
                
                -- Pequena pausa para segurança
                wait(0.1)
            end
            
            isGoingToAll = false
            
            WindUI:Notify({
                Title = "Coleta Completa!",
                Content = "✓ " .. chestsVisited .. " coletados | ✗ " .. chestsFailed .. " falhados",
                Duration = 5,
                Icon = "check-circle-2",
            })
        end)
    end
})

