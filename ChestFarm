-- Variáveis de controle
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local isTweening = false
local currentTween = nil
local tweenSpeed = 50
local useTween = true
local isGoingToAll = false
local visitedChests = {} -- Tabela para rastrear chests visitados

-- Função para encontrar todos os chests no workspace
local function findAllChests()
    local chests = {}
    for _, obj in pairs(game.Workspace:GetDescendants()) do
        if obj:IsA("Model") and (
            string.lower(obj.Name):find("chest") or 
            string.lower(obj.Name):find("crate") or
            string.lower(obj.Name):find("box")
        ) then
            -- Verifica se o chest tem uma posição válida
            local hasPosition = false
            if obj.PrimaryPart then
                hasPosition = true
            else
                for _, child in pairs(obj:GetDescendants()) do
                    if child:IsA("BasePart") then
                        hasPosition = true
                        break
                    end
                end
            end
            
            if hasPosition then
                table.insert(chests, obj)
            end
        end
    end
    return chests
end

-- Função para pegar a posição de um chest
local function getChestPosition(chest)
    if chest.PrimaryPart then
        return chest.PrimaryPart.Position
    end
    
    -- Procura qualquer parte no chest
    for _, child in pairs(chest:GetDescendants()) do
        if child:IsA("BasePart") then
            return child.Position
        end
    end
    
    return nil
end

-- Função para teleportar instantaneamente (sem kick)
local function instantTeleport(chest)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local targetPosition = getChestPosition(chest)
    if not targetPosition then
        return false
    end
    
    local humanoidRootPart = character.HumanoidRootPart
    
    -- TP instantâneo seguro
    humanoidRootPart.CFrame = CFrame.new(targetPosition) * CFrame.new(0, 5, 0)
    
    return true
end

-- Função para fazer tween até o chest
local function tweenToChest(chest)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    
    local targetPosition = getChestPosition(chest)
    if not targetPosition then
        return false
    end
    
    local humanoidRootPart = character.HumanoidRootPart
    
    isTweening = true
    
    local distance = (humanoidRootPart.Position - targetPosition).Magnitude
    local tweenTime = distance / tweenSpeed
    
    local tweenInfo = TweenInfo.new(
        tweenTime,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut
    )
    
    currentTween = TweenService:Create(humanoidRootPart, tweenInfo, {
        CFrame = CFrame.new(targetPosition) * CFrame.new(0, 5, 0)
    })
    
    currentTween:Play()
    currentTween.Completed:Wait()
    isTweening = false
    
    return true
end

-- Função para ir ao chest (escolhe entre tween ou TP)
local function goToChest(chest)
    if useTween then
        return tweenToChest(chest)
    else
        return instantTeleport(chest)
    end
end

-- Função para ordenar chests por distância do jogador
local function sortChestsByDistance(chests)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        return chests
    end
    
    local playerPos = character.HumanoidRootPart.Position
    
    table.sort(chests, function(a, b)
        local posA = getChestPosition(a)
        local posB = getChestPosition(b)
        
        if not posA then return false end
        if not posB then return true end
        
        local distA = (playerPos - posA).Magnitude
        local distB = (playerPos - posB).Magnitude
        
        return distA < distB
    end)
    
    return chests
end

