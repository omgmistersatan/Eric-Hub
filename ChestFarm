-- Auto Farm
local autoFarmEnabled = false
ControlSection:Toggle({
    Title = "Auto Farm Chests (Loop Seguro)",
    Desc = "Farm infinito com proteção anti-kick",
    Icon = "repeat",
    Type = "Checkbox",
    Value = false,
    Callback = function(state)
        autoFarmEnabled = state
        if state then
            WindUI:Notify({
                Title = "Auto Farm Ativado",
                Content = "Farm infinito iniciado com segurança!",
                Duration = 3,
                Icon = "infinity",
            })
            
            spawn(function()
                while autoFarmEnabled do
                    if not isCharacterValid() then
                        WindUI:Notify({
                            Title = "Aguardando",
                            Content = "Esperando personagem respawnar...",
                            Duration = 3,
                            Icon = "loader",
                        })
                        wait(5)
                        continue
                    end
                    
                    local allChests = findAllChests()
                    
                    if #allChests > 0 then
                        local chestsToVisit = allChests
                        local cycleCount = 0
                        
                        while autoFarmEnabled and #chestsToVisit > 0 do
                            if not isCharacterValid() then break end
                            
                            chestsToVisit = sortChestsByDistance(chestsToVisit)
                            
                            -- Remove inválidos
                            local validChests = {}
                            for _, chest in pairs(chestsToVisit) do
                                if chest and chest.Parent then
                                    table.insert(validChests, chest)
                                end
                            end
                            chestsToVisit = validChests
                            
                            if #chestsToVisit == 0 then break end
                            
                            local currentChest = table.remove(chestsToVisit, 1)
                            
                            if currentChest and currentChest.Parent then
                                local success = goToChest(currentChest)
                                if success then
                                    cycleCount = cycleCount + 1
                                end
                            end
                            
                            wait(0.1)
                        end
                        
                        if autoFarmEnabled and cycleCount > 0 then
                            WindUI:Notify({
                                Title = "Ciclo Completo",
                                Content = cycleCount .. " chests coletados. Reiniciando...",
                                Duration = 2,
                                Icon = "check",
                            })
                        end
                    end
                    
                    if autoFarmEnabled then
                        wait(3)
                    end
                end
            end)
        else
            WindUI:Notify({
                Title = "Auto Farm Desativado",
                Content = "Farm automático parado!",
                Duration = 2,
                Icon = "stop-circle",
            })
        end
    end
})

