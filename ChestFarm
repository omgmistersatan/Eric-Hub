-- Proteção Anti-Kick
local function setupAntiKick()
    -- Desabilita a verificação de velocidade do personagem
    if LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Proteção contra detecção de velocidade anormal
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                if method == "FireServer" and antiKickEnabled then
                    local args = {...}
                    -- Bloqueia chamadas de anti-cheat comuns
                    if string.find(tostring(self), "Anti") or string.find(tostring(self), "Kick") then
                        return wait(9e9)
                    end
                end
                return oldNamecall(self, ...)
            end)
        end
    end
end

-- Função para verificar se o personagem está válido
local function isCharacterValid()
    local character = LocalPlayer.Character
    if not character then return false end
    if not character:FindFirstChild("HumanoidRootPart") then return false end
    if not character:FindFirstChildOfClass("Humanoid") then return false end
    if character:FindFirstChildOfClass("Humanoid").Health <= 0 then return false end
    return true
end

-- Função para encontrar todos os chests no workspace
local function findAllChests()
    local chests = {}
    local success, result = pcall(function()
        for _, obj in pairs(game.Workspace:GetDescendants()) do
            if obj:IsA("Model") and obj.Parent and (
                string.lower(obj.Name):find("chest") or 
                string.lower(obj.Name):find("crate") or
                string.lower(obj.Name):find("box")
            ) then
                -- Verifica se o chest tem uma posição válida
                local hasPosition = false
                if obj.PrimaryPart and obj.PrimaryPart.Parent then
                    hasPosition = true
                else
                    for _, child in pairs(obj:GetDescendants()) do
                        if child:IsA("BasePart") and child.Parent then
                            hasPosition = true
                            break
                        end
                    end
                end
                
                if hasPosition then
                    table.insert(chests, obj)
                end
            end
        end
    end)
    
    if not success then
        warn("Erro ao buscar chests:", result)
        return {}
    end
    
    return chests
end

-- Função para pegar a posição de um chest
local function getChestPosition(chest)
    if not chest or not chest.Parent then return nil end
    
    if chest.PrimaryPart and chest.PrimaryPart.Parent then
        return chest.PrimaryPart.Position
    end
    
    -- Procura qualquer parte no chest
    for _, child in pairs(chest:GetDescendants()) do
        if child:IsA("BasePart") and child.Parent then
            return child.Position
        end
    end
    
    return nil
end

-- Função para teleportar com segurança (anti-kick)
local function safeTeleport(targetCFrame)
    if not isCharacterValid() then return false end
    
    local character = LocalPlayer.Character
    local humanoidRootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Desabilita temporariamente a física
    local originalCFrame = humanoidRootPart.CFrame
    
    -- Método 1: Teleporte em etapas (mais seguro)
    if useTween then
        -- Já usa tween, que é mais seguro
        return true
    else
        -- TP instantâneo com proteção
        local success = pcall(function()
            -- Desabilita colisões temporariamente
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            
            -- Teleporta
            humanoidRootPart.CFrame = targetCFrame
            
            -- Aguarda um frame
            RunService.Heartbeat:Wait()
            
            -- Reabilita colisões
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end)
        
        if not success then
            humanoidRootPart.CFrame = originalCFrame
            return false
        end
        
        return true
    end
end

-- Função para teleportar instantaneamente com proteção
local function instantTeleport(chest)
    if not isCharacterValid() then return false end
    if not chest or not chest.Parent then return false end
    
    local targetPosition = getChestPosition(chest)
    if not targetPosition then return false end
    
    local character = LocalPlayer.Character
    local humanoidRootPart = character.HumanoidRootPart
    
    local targetCFrame = CFrame.new(targetPosition) * CFrame.new(0, 5, 0)
    
    return safeTeleport(targetCFrame)
end

-- Função para fazer tween até o chest com proteção
local function tweenToChest(chest)
    if not isCharacterValid() then return false end
    if not chest or not chest.Parent then return false end
    
    local targetPosition = getChestPosition(chest)
    if not targetPosition then return false end
    
    local character = LocalPlayer.Character
    local humanoidRootPart = character.HumanoidRootPart
    
    isTweening = true
    
    local distance = (humanoidRootPart.Position - targetPosition).Magnitude
    local tweenTime = distance / tweenSpeed
    
    -- Limita o tempo máximo do tween para evitar problemas
    if tweenTime > 30 then
        tweenTime = 30
    end
    
    local tweenInfo = TweenInfo.new(
        tweenTime,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut
    )
    
    local success = pcall(function()
        currentTween = TweenService:Create(humanoidRootPart, tweenInfo, {
            CFrame = CFrame.new(targetPosition) * CFrame.new(0, 5, 0)
        })
        
        currentTween:Play()
        
        -- Aguarda com timeout
        local startTime = tick()
        local completed = false
        
        currentTween.Completed:Connect(function()
            completed = true
        end)
        
        -- Espera o tween completar ou timeout
        while not completed and (tick() - startTime) < tweenTime + 5 do
            if not isGoingToAll and not autoFarmEnabled then
                currentTween:Cancel()
                break
            end
            wait(0.1)
        end
        
        if not completed then
            currentTween:Cancel()
        end
    end)
    
    isTweening = false
    
    return success
end

-- Função para ir ao chest com verificações de segurança
local function goToChest(chest)
    if not chest or not chest.Parent then return false end
    if not isCharacterValid() then return false end
    
    local success = false
    
    if useTween then
        success = tweenToChest(chest)
    else
        success = instantTeleport(chest)
    end
    
    -- Aguarda entre chests para evitar detecção
    if success then
        wait(waitBetweenChests)
    end
    
    return success
end

-- Função para ordenar chests por distância
local function sortChestsByDistance(chests)
    if not isCharacterValid() then return chests end
    
    local character = LocalPlayer.Character
    local playerPos = character.HumanoidRootPart.Position
    
    local validChests = {}
    
    -- Filtra chests válidos
    for _, chest in pairs(chests) do
        if chest and chest.Parent then
            local pos = getChestPosition(chest)
            if pos then
                table.insert(validChests, chest)
            end
        end
    end
    
    table.sort(validChests, function(a, b)
        local posA = getChestPosition(a)
        local posB = getChestPosition(b)
        
        if not posA then return false end
        if not posB then return true end
        
        local distA = (playerPos - posA).Magnitude
        local distB = (playerPos - posB).Magnitude
        
        return distA < distB
    end)
    
    return validChests
end

