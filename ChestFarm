-- Toggle para auto-farm chests (loop infinito)
local autoFarmEnabled = false
ControlSection:Toggle({
    Title = "Auto Farm Chests (Loop)",
    Desc = "Automaticamente coleta TODOS os chests em loop infinito",
    Icon = "repeat",
    Type = "Checkbox",
    Value = false,
    Callback = function(state)
        autoFarmEnabled = state
        if state then
            WindUI:Notify({
                Title = "Auto Farm Ativado",
                Content = "Começando farm infinito de TODOS os chests!",
                Duration = 3,
                Icon = "infinity",
            })
            
            spawn(function()
                while autoFarmEnabled do
                    local allChests = findAllChests()
                    
                    if #allChests > 0 then
                        WindUI:Notify({
                            Title = "Novo Ciclo",
                            Content = "Farmando " .. #allChests .. " chests do mapa",
                            Duration = 2,
                            Icon = "refresh-cw",
                        })
                        
                        local chestsToVisit = allChests
                        local cycleCount = 0
                        
                        while autoFarmEnabled and #chestsToVisit > 0 do
                            -- Reordena pela distância
                            chestsToVisit = sortChestsByDistance(chestsToVisit)
                            
                            -- Pega o mais próximo
                            local currentChest = table.remove(chestsToVisit, 1)
                            
                            if currentChest and currentChest.Parent then
                                goToChest(currentChest)
                                cycleCount = cycleCount + 1
                                
                                if not useTween then
                                    wait(0.3)
                                else
                                    wait(0.5)
                                end
                            end
                        end
                        
                        if autoFarmEnabled then
                            WindUI:Notify({
                                Title = "Ciclo Completo",
                                Content = "Coletou " .. cycleCount .. " chests. Reiniciando...",
                                Duration = 2,
                                Icon = "check",
                            })
                        end
                    end
                    
                    if autoFarmEnabled then
                        wait(3) -- Espera 3 segundos antes do próximo ciclo
                    end
                end
            end)
        else
            WindUI:Notify({
                Title = "Auto Farm Desativado",
                Content = "Farm automático parado!",
                Duration = 2,
                Icon = "stop-circle",
            })
        end
    end
})

